# Copy this file to .env.local and fill in values from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-database-url
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-me

# Dashboard data path; leave as feeder-01 unless you intentionally change the Firebase rules and firmware.
VITE_DEVICE_ID=feeder-01
# Used only to determine whether the latest heartbeat is stale (milliseconds).
VITE_OFFLINE_TIMEOUT_MS=30000
